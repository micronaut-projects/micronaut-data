<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- tag::notification-function[] -->
    <changeSet id="postgres-notification-function"
               author="application"
               dbms="postgresql"
               runOnChange="true">

        <sql>SET LOCAL search_path TO public</sql>

        <sqlFile
            path="io/micronaut/data/jdbc/notification/postgres/create-notification-function.sql"
            relativeToChangelogFile="false"
            splitStatements="false"/>
    </changeSet>
    <!-- end::notification-function[] -->

    <changeSet id="create-books" author="application" dbms="postgresql">
        <sqlFile path="create-books.sql" relativeToChangelogFile="true"/>
    </changeSet>
</databaseChangeLog>
